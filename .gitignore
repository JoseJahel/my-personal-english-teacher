# Dependencias de Node.js: se reinstalan con pnpm, no deben versionarse.
node_modules/

# Carpetas de salida de build/compilación (Vite, Webpack, etc.).
dist/
build/

# Variables de entorno y secretos: nunca deben subirse al repo.
.env
.env.*
!.env.example
!.env.latency
!.env.ensayo

# Carpeta privada local de cada integrante (credenciales, .env, claves API,
# notas personales). Cada quien mantiene la suya; nunca se versiona.
_private/

# Archivos temporales de Microsoft Office (Word, Excel, PowerPoint).
~$*
*.tmp

# Basura generada por el sistema operativo (principalmente Windows).
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Configuración de IDEs/editores. Se ignora la carpeta completa;
# si luego se quiere compartir configuración de VSCode del equipo,
# se puede exceptuar puntualmente con "!.vscode/settings.json".
.vscode/
.idea/

# Logs generales de la aplicación o de herramientas de build.
*.log

# Libros/PDF en bruto de estudio (copyright); el temario va en estudio/procesado/.
estudio/bruto/*.pdf
estudio/bruto/*.docx
estudio/bruto/*.epub

# Cualquier captura suelta en la raíz es material de trabajo local, no del producto.
# Las capturas que sí son entregable van versionadas en Documentacion general/entregas/capturas/.
/*.png

# Capturas locales de la sesión de estudio (no producto).
/estudio-*.png
/qa-*.png
/coaching-tips-*.png
/home-idle.png
/practice-mock-turn.png
/suggestions-*.png

# Artefactos locales de pruebas de UI / automatización del navegador.
# No son del producto; cada quien los genera al probar y no deben ir al repo.
# Preferir guardarlos en una carpeta local de trabajo (no versionada), no en la raíz.
.playwright-mcp/
/test-*.png
/ui-*.png
/ux-*.png
/functional-test-*.png
/app-ready-for-test.png

# Cache/modelos de IA descargados localmente para pruebas.
# Los modelos de Hugging Face (Whisper, SpeechT5, T5) se descargan
# en tiempo de ejecución en el navegador del usuario final, así que
# no deberían versionarse copias locales pesadas. Si en desarrollo se
# llegan a guardar modelos en disco para pruebas, se ignoran aquí:
# models/
# *.onnx

# Runtime logs from deep-scan git sync hook
.grok/hooks/state/

# Empaquetados pesados de documentación (usar los .md del repo, no zips).
Documentacion general.zip
**/Documentacion general.zip

# Estado local de herramientas de revisión / automatización (no producto).
.crosscut/
